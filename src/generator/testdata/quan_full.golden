[SERVER]
ss-plain = shadowsocks, ss.example.com, 8388, aes-256-gcm, "pass:word=", group=
ssr-node = shadowsocksr, ssr.example.com, 8389, aes-128-cfb, "ssrpass", group=, protocol=auth_aes128_md5, obfs=http_simple, protocol_param=1234:abc, obfs_param=obfs.example.com
vmess-ws = vmess, vmess.example.com, 443, chacha20-ietf-poly1305, "b445361a-abcf-4a4a-a97a-0bf4136d6ddc", group=, over-tls=true, tls-host=host.example.com, obfs=ws, obfs-path="/ws", obfs-header="Host: host.example.com"
http-node = http, upstream-proxy-address=http.example.com, upstream-proxy-port=8080, group=, upstream-proxy-auth=true, upstream-proxy-username=httpuser, upstream-proxy-password=httppass
socks-node = socks, upstream-proxy-address=socks.example.com, upstream-proxy-port=1080, group=, upstream-proxy-auth=true, upstream-proxy-username=sockuser, upstream-proxy-password=sockpass

